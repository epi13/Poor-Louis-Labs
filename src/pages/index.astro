---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects, categories } from '../data/projects';
const base = import.meta.env.BASE_URL;
const href = (path='') => `${base}${path}`.replace(/\/+/g,'/');
const featured = projects.filter((project) => project.featured && !project.flagship).slice(0,6);
---
<BaseLayout title="Poor Louis Labs — Research, standards, and practical systems from Alaska">
  <div class="shell">
    <section class="hero">
      <div>
        <div class="eyebrow">Independent research and engineering practice</div>
        <h1>Research, standards, and practical systems from Alaska.</h1>
        <p class="lede">Poor Louis Labs develops machine-native software assurance methods, graph-grounded agent tools, substrate-aware computing experiments, construction software, creative systems, and the digital infrastructure supporting Poor Louis Farms.</p>
        <div class="button-row">
          <a class="button primary" href={href('projects/')}>Explore projects</a>
          <a class="button" href={href('mncs/')}>Read about MNCS</a>
          <a class="button" href="https://github.com/epi13">View GitHub</a>
        </div>
      </div>
      <aside class="hero-aside" aria-label="Portfolio summary">
        <div class="metric"><strong>{projects.length}</strong>cataloged public repositories</div>
        <div class="metric"><strong>{categories.length}</strong>working areas</div>
        <div class="metric"><strong>1</strong>flagship standards program</div>
      </aside>
    </section>

    <section class="section" aria-labelledby="mncs-heading">
      <div class="flagship">
        <div>
          <div class="kicker">Flagship program · MNCS 0.2 / MNCDS 0.1 draft</div>
          <h2 id="mncs-heading">Machine-native complexity under human-readable control.</h2>
          <p>The Machine-Native Complexity Standard addresses generated implementations whose internals may exceed ordinary human-maintainability limits. It requires that complexity purchase a declared, measurable benefit inside an auditable envelope of contracts, evidence, safety, resources, provenance, trust, regeneration, and rollback.</p>
          <div class="button-row"><a class="button primary" href={href('mncs/')}>Explore the standard</a><a class="button" href="https://github.com/epi13/machine-native-complexity-standard">Open repository</a></div>
        </div>
        <div><p class="quote">“Human readability is relocated, not eliminated.”</p><p>MNCS evaluates implementation evidence. MNCDS separately evaluates the development process. Neither claim implies the other.</p></div>
      </div>
    </section>

    <section class="section">
      <div class="section-head"><h2>Current programs</h2><p>The portfolio is organized by purpose and evidence boundary, not by treating every repository as equally mature.</p></div>
      <div class="program-list">
        {categories.map((category) => <div class="program"><div class="kicker">{projects.filter((p) => p.category === category).length} projects</div><h3>{category}</h3></div>)}
      </div>
    </section>

    <section class="section">
      <div class="section-head"><h2>Selected work</h2><p>Standards, research infrastructure, practical utilities, and systems with clearly stated maturity and limitations.</p></div>
      <div class="grid">{featured.map((project) => <ProjectCard project={project} feature />)}</div>
    </section>

    <section class="section">
      <div class="section-head"><h2>Working principles</h2><p>Machine assistance can increase implementation complexity. Human control must become more explicit, not less.</p></div>
      <div class="grid">
        <article class="card"><h3>Readable control</h3><p>Specifications, contracts, limits, reference behavior, and acceptance policy remain inspectable.</p></article>
        <article class="card"><h3>Evidence before claims</h3><p>Results are scoped to what was measured, under the environment and policy that produced them.</p></article>
        <article class="card"><h3>Regenerable systems</h3><p>Generated complexity should have recorded provenance, repeatable inputs, rollback, and retirement paths.</p></article>
      </div>
    </section>

    <section class="section">
      <div class="section-head"><h2>Labs and farm</h2><p>Poor Louis Farms is the family farm and commercial operation. Poor Louis Labs is its research, software, technical, and experimental companion.</p></div>
      <p class="lede">The Labs portfolio includes the editorial system supporting the farm, but the Square storefront remains authoritative for prices, availability, options, and checkout.</p>
      <div class="button-row"><a class="button" href={href('projects/poor-louis-farms/')}>View the digital system</a><a class="button" href="https://poor-louis-farms.square.site/">Visit the storefront</a></div>
    </section>
  </div>
</BaseLayout>
