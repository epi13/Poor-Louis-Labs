---
import type { Project } from '../data/projects';
const { project, feature = false } = Astro.props as { project: Project; feature?: boolean };
const base = import.meta.env.BASE_URL;
const href = `${base}projects/${project.slug}/`.replace(/\/+/g, '/');
---
<article class:list={['card', { feature }]} data-category={project.category}>
  <div class="kicker">{project.category}</div>
  <h3><a href={href}>{project.name}</a></h3>
  <p>{project.summary}</p>
  <div class="meta">
    <span class="tag">{project.maturity}</span>
    <span class="tag">{project.projectType}</span>
  </div>
</article>
