---
import '../styles/global.css';
const { title = 'Poor Louis Labs', description = 'Independent Alaskan research and engineering practice developing open standards, agent tooling, experimental computing systems, and practical software.' } = Astro.props;
const base = import.meta.env.BASE_URL;
const current = Astro.url.pathname;
const nav = [
  ['Projects', 'projects/'], ['MNCS', 'mncs/'], ['Research', 'research/'], ['Notes', 'notes/'], ['About', 'about/']
];
const href = (path = '') => `${base}${path}`.replace(/\/+/g, '/');
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#f2f0e9" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content={new URL(href('social-card.svg'), Astro.url)} />
  <title>{title}</title>
</head>
<body>
<a class="skip" href="#content">Skip to content</a>
<header class="site-header">
  <nav class="nav" aria-label="Primary navigation">
    <a class="brand" href={href()}>
      Poor Louis Labs
      <span>PALMER / ALASKA · INDEPENDENT R&amp;D</span>
    </a>
    <div class="nav-links">
      {nav.map(([label, path]) => <a href={href(path)} aria-current={current.includes(`/${path}`) ? 'page' : undefined}>{label}</a>)}
    </div>
  </nav>
</header>
<main id="content"><slot /></main>
<footer>
  <div class="shell footer-grid">
    <div><strong>Poor Louis Labs</strong><br />Independent research, engineering, and practical software from Alaska.</div>
    <div><a href="https://github.com/epi13">GitHub</a><br /><a href="https://poor-louis-farms.square.site/">Poor Louis Farms storefront</a></div>
  </div>
</footer>
</body>
</html>
